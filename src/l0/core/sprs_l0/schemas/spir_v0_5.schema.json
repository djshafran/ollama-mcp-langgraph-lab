{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprs-l0.local/schemas/spir_v0_5.schema.json",
  "title": "SPIR v0.5",
  "type": "object",
  "required": [
    "meta",
    "normalized_text",
    "tokens",
    "segments",
    "capabilities",
    "syntax",
    "semantics"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "artifacts_hash", "input_hash"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^0\\.5\\.0$"
        },
        "artifacts_hash": {
          "type": "string"
        },
        "input_hash": {
          "type": "string"
        },
        "input_format": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "normalized_text": {
      "type": "string"
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface", "lemma"],
        "properties": {
          "surface": {
            "type": "string"
          },
          "lemma": {
            "type": "string"
          },
          "pos": {
            "type": ["string", "null"]
          },
          "feats": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "segments": {
      "type": "array"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "syntax": {
      "type": "object",
      "required": ["backend", "paninian_edges", "ud", "clauses", "discourse_links", "meta"],
      "properties": {
        "backend": {
          "type": "string"
        },
        "paninian_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["head", "dep", "role"],
            "properties": {
              "head": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "dep": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "conf": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        },
        "ud": {
          "type": "object"
        },
        "clauses": {
          "type": "array"
        },
        "discourse_links": {
          "type": "array"
        },
        "meta": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "semantics": {
      "type": "object",
      "required": ["kag"],
      "properties": {
        "kag": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
