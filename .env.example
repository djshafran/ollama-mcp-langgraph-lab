# Ollama model (change to qwen2.5:7b, qwen2.5-coder:7b, etc.)
MODEL=qwen3:8b

# inside docker network, reach Ollama by service name
OLLAMA_BASE_URL=http://ollama:11434

# MCP server (FastMCP) inside docker network
MCP_URL=http://mcp:8000/mcp

# agent system prompt
SYSTEM_PROMPT=You are a lab assistant. Use tools when helpful. Be concise in final answers.

# generation params
TEMPERATURE=0.2

# context size (higher = more RAM/VRAM)
NUM_CTX=8192

# reasoning / thinking mode for supported models (true/false/empty)
# langchain-ollama supports `reasoning` and can return reasoning separately
REASONING=true

# whether to print reasoning to console (usually 0)
SHOW_REASONING=0
