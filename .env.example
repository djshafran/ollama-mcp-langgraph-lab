# Ollama model (change to qwen2.5:7b, qwen2.5-coder:7b, etc.)
MODEL=qwen3:8b

# inside docker network, reach Ollama by service name
OLLAMA_BASE_URL=http://ollama:11434

# MCP server (FastMCP) inside docker network
MCP_URL=http://mcp:8000/mcp

# L0 MCP server inside docker network
L0_MCP_URL=http://l0:8000/mcp

# L0 backend selection
L0_BACKEND=heritage

# L0 syntax backend (rules | hydra | hyderabad | none)
SYNTAX_BACKEND=rules

# Heritage.py local (shell) mode
HERITAGE_METHOD=shell
HERITAGE_BASE_DIR=/opt/Heritage_Platform
HERITAGE_REQUEST_TIMEOUT=5
HERITAGE_REQUEST_ATTEMPTS=4
HERITAGE_LEXICON=SH

# agent system prompt
SYSTEM_PROMPT=You are a lab assistant. Use tools when helpful. Be concise in final answers.

# generation params
TEMPERATURE=0.2

# context size (higher = more RAM/VRAM)
NUM_CTX=8192

# reasoning / thinking mode for supported models (true/false/empty)
# langchain-ollama supports `reasoning` and can return reasoning separately
REASONING=true

# reasoning module selection for flow-mode
PLAN_BACKEND=llm
RECONCILE_BACKEND=llm

# thinking trace is telemetry, not a planner
THINKING_TRACE=true

# whether to print reasoning to console (usually 0)
SHOW_REASONING=0
